{#- Pinta cada sección de una página según su tipo. Los tipos y sus campos están en .pages.yml -#}
{%- macro cabeza(s, h = 'h2') -%}
{%- if s.antetitulo %}<p class="ante">— {{ s.antetitulo }}</p>{% endif -%}
{%- if s.titulo %}<{{ h }} class="titular">{{ s.titulo | titulo | safe }}</{{ h }}>{% endif -%}
{%- if s.subtitulo %}<p class="sub">{{ s.subtitulo }}</p>{% endif -%}
{%- endmacro -%}
{%- macro boton(b) -%}
<a class="btn btn-{{ b.estilo or 'negro' }}" href="{{ b.enlace }}">{{ b.texto }}</a>
{%- endmacro -%}

{%- for s in secciones %}
{%- set primera = loop.first %}

{%- if s.tipo == 'portada' %}
{%- set con_panel = s.video or s.imagen or s.imagen_hueco %}
<section class="portada{% if not con_panel %} portada-solo{% endif %}">
  <div class="ancho portada-in">
    <div class="portada-texto">
      {%- if s.antetitulo %}<p class="ante">— {{ s.antetitulo }}</p>{% endif %}
      <{{ 'h1' if primera else 'h2' }} class="portada-titulo">{{ s.titulo | titulo | safe }}</{{ 'h1' if primera else 'h2' }}>
      {%- if s.subtitulo %}<p class="portada-sub">{{ s.subtitulo }}</p>{% endif %}
      {%- if s.texto %}<p class="portada-texto-p">{{ s.texto | safe }}</p>{% endif %}
      {%- if s.botones and s.botones.length %}
      <div class="botones">{% for b in s.botones %}{{ boton(b) }}{% endfor %}</div>
      {%- endif %}
      {%- if s.nota %}<p class="portada-nota">{{ s.nota | safe }}</p>{% endif %}
    </div>
    {%- if s.video %}
    <figure class="portada-foto portada-video">
      <video src="{{ s.video }}"{% if s.imagen %} poster="{{ s.imagen }}"{% endif %} autoplay muted loop playsinline preload="auto" aria-label="{{ s.imagen_alt }}"></video>
    </figure>
    {%- elif s.imagen %}
    <figure class="portada-foto"><img src="{{ s.imagen }}" alt="{{ s.imagen_alt }}" loading="eager"></figure>
    {%- elif s.imagen_hueco %}
    <div class="portada-panel" aria-hidden="true"><span>{{ s.imagen_hueco }}</span></div>
    {%- endif %}
  </div>
</section>

{%- elif s.tipo == 'clientes' %}
<section class="clientes">
  <div class="ancho">
    <div class="clientes-barra">
      {%- for i in s.items %}
      <a class="cliente" href="{{ i.enlace }}"><span class="num">{{ loop.index | dosCifras }}</span><strong>{{ i.titulo }}</strong><span class="cliente-txt">{{ i.texto }} →</span></a>
      {%- endfor %}
    </div>
  </div>
</section>

{%- elif s.tipo == 'tarjetas' %}
<section class="bloque f-{{ s.fondo or 'blanco' }}">
  <div class="ancho">
    <div class="cabeza">{{ cabeza(s) }}</div>
    <div class="tarjetas">
      {%- for i in s.items %}
      <article class="tarjeta">
        {%- if i.imagen %}<img class="tarjeta-foto" src="{{ i.imagen }}" alt="{{ i.imagen_alt }}" loading="lazy">{% endif %}
        <div class="tarjeta-in">
          {%- if i.etiqueta %}<span class="etiqueta">{{ i.etiqueta }}</span>{% endif %}
          <h3>{{ i.titulo }}</h3>
          {%- if i.texto %}<p>{{ i.texto }}</p>{% endif %}
          {%- if i.enlace %}<a class="mas" href="{{ i.enlace }}">{{ i.enlace_texto or '→' }} <span aria-hidden="true">→</span></a>{% endif %}
        </div>
      </article>
      {%- endfor %}
    </div>
  </div>
</section>

{%- elif s.tipo == 'pasos' %}
<section class="bloque f-{{ s.fondo or 'gris' }}">
  <div class="ancho">
    <div class="cabeza">{{ cabeza(s) }}</div>
    <ol class="pasos pasos-{{ s.estilo or 'numerado' }}">
      {%- for i in s.items %}
      <li class="paso"><span class="num" aria-hidden="true">{{ loop.index | dosCifras }}</span><h3>{{ i.titulo }}</h3><p>{{ i.texto }}</p></li>
      {%- endfor %}
    </ol>
  </div>
</section>

{%- elif s.tipo == 'lista' %}
<section class="bloque f-{{ s.fondo or 'negro' }}">
  <div class="ancho dos-col">
    <div class="cabeza">{{ cabeza(s) }}</div>
    <ul class="lista">
      {%- for i in s.items %}
      <li><span class="num" aria-hidden="true">{{ loop.index | dosCifras }}</span><div><strong>{{ i.titulo }}</strong>{% if i.texto %}<p>{{ i.texto }}</p>{% endif %}</div>{% if i.etiqueta %}<span class="etiqueta">{{ i.etiqueta }}</span>{% endif %}</li>
      {%- endfor %}
    </ul>
  </div>
</section>

{%- elif s.tipo == 'casillas' %}
<section class="bloque f-{{ s.fondo or 'gris' }}">
  <div class="ancho dos-col">
    <div class="cabeza">{{ cabeza(s) }}</div>
    <div class="casillas">
      {%- for i in s.items %}
      <div class="casilla{% if i.destacada %} destacada{% endif %}"><span class="num">{{ i.etiqueta or (loop.index | dosCifras) }}</span><strong>{{ i.titulo }}</strong>{% if i.texto %}<p>{{ i.texto }}</p>{% endif %}</div>
      {%- endfor %}
    </div>
  </div>
</section>

{%- elif s.tipo == 'texto' %}
<section class="bloque f-{{ s.fondo or 'blanco' }}">
  <div class="ancho dos-col">
    <div class="cabeza">{%- if s.antetitulo %}<p class="ante">— {{ s.antetitulo }}</p>{% endif %}</div>
    <div class="texto">
      {%- if s.titulo %}<h2 class="texto-titulo">{{ s.titulo | titulo | safe }}</h2>{% endif %}
      <div class="prosa">{{ s.cuerpo | safe }}</div>
      {%- if s.firma %}<p class="firma">{{ s.firma }}</p>{% endif %}
    </div>
  </div>
</section>

{%- elif s.tipo == 'imagen_texto' %}
<section class="bloque f-{{ s.fondo or 'blanco' }}">
  <div class="ancho foto-texto{% if s.lado == 'derecha' %} foto-derecha{% endif %}">
    {%- if s.imagen %}<figure class="ft-foto"><img src="{{ s.imagen }}" alt="{{ s.imagen_alt }}" loading="lazy"></figure>{% endif %}
    <div class="ft-texto">
      {{ cabeza(s) }}
      <div class="prosa">{{ s.cuerpo | safe }}</div>
      {%- if s.boton_texto %}<a class="btn btn-negro" href="{{ s.boton_enlace }}">{{ s.boton_texto }}</a>{% endif %}
    </div>
  </div>
</section>

{%- elif s.tipo == 'cita' %}
<section class="cita">
  <div class="ancho"><p>{{ s.frase | titulo | safe }}</p></div>
</section>

{%- elif s.tipo == 'horario' %}
<section class="bloque f-{{ s.fondo or 'blanco' }}">
  <div class="ancho">
    <div class="cabeza">{{ cabeza(s) }}</div>
    <ol class="horario">
      {%- for i in s.items %}
      <li><span class="hora">{{ i.hora }}</span><div><h3>{{ i.titulo }}</h3><p>{{ i.texto }}</p>{% if i.nota %}<p class="nota-mano">{{ i.nota }}</p>{% endif %}</div></li>
      {%- endfor %}
    </ol>
  </div>
</section>

{%- elif s.tipo == 'galeria' %}
{%- if s.fotos and s.fotos.length %}
<section class="bloque f-{{ s.fondo or 'blanco' }}">
  <div class="ancho">
    <div class="cabeza">{{ cabeza(s) }}</div>
    <div class="galeria">
      {%- for f in s.fotos %}
      <figure><img src="{{ f.imagen }}" alt="{{ f.alt }}" loading="lazy">{% if f.pie %}<figcaption>{{ f.pie }}</figcaption>{% endif %}</figure>
      {%- endfor %}
    </div>
  </div>
</section>
{%- endif %}

{%- elif s.tipo == 'noticias' %}
{%- set lista = sitio.noticias | deIdioma(idioma) | primeros(s.cantidad or 3) %}
{%- if lista.length %}
<section class="bloque f-{{ s.fondo or 'blanco' }}">
  <div class="ancho">
    <div class="cabeza cabeza-fila">{{ cabeza(s) }}<a class="mas" href="{{ sitio.ajustes[idioma].ruta_noticias }}">{{ sitio.ajustes[idioma].titulo_noticias }} →</a></div>
    {% set noticias_lista = lista %}{% include "lista-noticias.njk" %}
  </div>
</section>
{%- endif %}

{%- elif s.tipo == 'llamada' %}
<section class="llamada">
  <div class="ancho">
    <div class="llamada-fila">
      <div>
        {%- if s.antetitulo %}<p class="ante">— {{ s.antetitulo }}</p>{% endif %}
        <h2 class="titular">{{ s.titulo | titulo | safe }}</h2>
        {%- if s.subtitulo %}<p class="sub">{{ s.subtitulo }}</p>{% endif %}
      </div>
      {%- if s.botones and s.botones.length %}
      <div class="botones">{% for b in s.botones %}<a class="btn {{ 'btn-negro' if b.estilo == 'rojo' else 'btn-blanco-linea' }}" href="{{ b.enlace }}">{{ b.texto }}</a>{% endfor %}</div>
      {%- endif %}
    </div>
    {%- if s.columnas and s.columnas.length %}
    <div class="llamada-cols">
      {%- for c in s.columnas %}
      <div class="llamada-col"><h3>{{ c.titulo }}</h3><p>{{ c.texto }}</p><a class="btn btn-negro" href="{{ c.enlace }}">{{ c.boton_texto }}</a></div>
      {%- endfor %}
    </div>
    {%- endif %}
  </div>
</section>

{%- elif s.tipo == 'contacto' %}
{%- set aj = sitio.ajustes[idioma] %}
<section class="bloque f-blanco">
  <div class="ancho dos-col">
    <div>
      {%- if s.antetitulo %}<p class="ante">— {{ s.antetitulo }}</p>{% endif %}
      <ul class="tipos">
        {%- for t in s.tipos %}
        <li data-tipo="{{ t.clave }}"><strong>{{ t.titulo }}</strong><span>{{ t.texto }}</span></li>
        {%- endfor %}
      </ul>
    </div>
    <div class="escribe">
      <h2 class="titular">{{ s.titulo }}</h2>
      <a class="correo-grande" data-mailto href="mailto:{{ aj.correo }}">{{ aj.correo }}</a>
      <a class="btn btn-rojo" data-mailto href="mailto:{{ aj.correo }}">{{ s.boton_texto }}</a>
      {%- if s.ayuda %}<p class="ayuda">{% for l in s.ayuda | lineas %}{{ l }}<br>{% endfor %}</p>{% endif %}
    </div>
  </div>
</section>
{%- endif %}
{%- endfor %}
