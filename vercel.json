{
  "buildCommand": "npm run build",
  "outputDirectory": "_site",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/veladas",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/ca/vetllades",
      "destination": "/ca",
      "statusCode": 301
    },
    {
      "source": "/en/evenings",
      "destination": "/en",
      "statusCode": 301
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "lavirage.vercel.app"
        }
      ],
      "destination": "https://www.lavirageclub.com/$1",
      "statusCode": 301
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "lavirageclub.com"
        }
      ],
      "destination": "https://www.lavirageclub.com/$1",
      "statusCode": 301
    }
  ]
}
