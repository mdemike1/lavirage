{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "lavirageclub.com" }],
      "destination": "https://lavirage.vercel.app/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.lavirageclub.com" }],
      "destination": "https://lavirage.vercel.app/:path*",
      "permanent": true
    }
  ]
}
